---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import '../style/global.css';

import Header from '../components/Header.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  title?: string;
  activeRole?: 'ciudadano' | 'comite';
  activePage?: string;
}

const { title = 'Ciudad Segura Quito', activeRole = 'ciudadano', activePage = 'mapa' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#071324" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | Comité de Seguridad Barrio La Carolina Quito</title>

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
</head>
<body class="bg-navy-darker">

  <Header activeRole={activeRole} activePage={activePage} />
  <DisclaimerBanner />

  <main class="main-content flex-grow-1 py-3 px-2 px-md-4">
    <slot />
  </main>

  <BottomNav activePage={activePage} activeRole={activeRole} />

  <!-- Leaflet JS & Bootstrap Bundle JS -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>