---
interface Props {
  activeRole?: 'ciudadano' | 'comite';
  activePage?: string;
}

const { activeRole = 'ciudadano', activePage = 'mapa' } = Astro.props;
---

<header class="cg-header py-3 px-3 px-md-4">
  <div class="container-fluid">
    <div class="row align-items-center gy-2">
      
      <!-- Brand & Neighborhood Title -->
      <div class="col-12 col-md-5 d-flex align-items-center gap-3">
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
          <div class="p-2 rounded-3 bg-primary bg-gradient text-white d-flex align-items-center justify-content-center shadow" style="width: 42px; height: 42px;">
            <i class="bi bi-shield-lock-fill fs-4"></i>
          </div>
          <div>
            <h1 class="h5 mb-0 fw-bold text-white tracking-tight">CIUDAD SEGURA</h1>
            <span class="small text-slate-400 d-block" style="font-size: 0.75rem; color: #94a3b8;">
              <i class="bi bi-geo-alt-fill text-danger me-1"></i>Comité de Seguridad • La Carolina, Quito
            </span>
          </div>
        </a>
        <div class="d-none d-lg-flex align-items-center gap-2 ms-2 px-3 py-1 rounded-pill bg-slate-900 border border-slate-700" style="background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b;">
          <span class="live-dot"></span>
          <span class="small font-monospace text-uppercase" style="font-size: 0.7rem; color: #34d399; letter-spacing: 0.5px;">Sistema Activo</span>
        </div>
      </div>

      <!-- Quick Nav for Desktop -->
      <div class="col-12 col-md-4 d-none d-md-flex align-items-center justify-content-center">
        <nav class="d-flex gap-2 p-1 rounded-pill" style="background: rgba(17, 38, 71, 0.7); border: 1px solid #1e3a66;">
          <a href="/" class={`btn btn-sm px-3 rounded-pill text-white ${activePage === 'mapa' ? 'btn-primary shadow' : 'btn-link text-decoration-none text-slate-300'}`}>
            <i class="bi bi-map-fill me-1"></i> Mapa
          </a>
          <a href="/reportar" class={`btn btn-sm px-3 rounded-pill text-white ${activePage === 'reportar' ? 'btn-primary shadow' : 'btn-link text-decoration-none text-slate-300'}`}>
            <i class="bi bi-plus-circle-fill me-1"></i> Reportar
          </a>
          <a href="/mis-reportes" class={`btn btn-sm px-3 rounded-pill text-white ${activePage === 'mis-reportes' ? 'btn-primary shadow' : 'btn-link text-decoration-none text-slate-300'}`}>
            <i class="bi bi-person-lines-fill me-1"></i> Mis Reportes
          </a>
          <a href="/comite/reportes" class={`btn btn-sm px-3 rounded-pill text-white ${activePage === 'comite' ? 'btn-primary shadow' : 'btn-link text-decoration-none text-slate-300'}`}>
            <i class="bi bi-sliders me-1"></i> Comité
          </a>
        </nav>
      </div>

      <!-- Role Switcher & User Profile -->
      <div class="col-12 col-md-3 d-flex align-items-center justify-content-between justify-content-md-end gap-2">
        
        <!-- Interactive Demo Role Switcher -->
        <div class="dropdown">
          <button class="btn btn-sm rounded-pill d-flex align-items-center gap-2 border px-3" style="background: rgba(15, 23, 42, 0.8); border-color: #3b82f6 !important; color: #f8fafc;" type="button" id="roleDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            {activeRole === 'comite' ? (
              <span class="badge bg-danger text-white rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                <i class="bi bi-shield-shaded me-1"></i> COMITÉ
              </span>
            ) : (
              <span class="badge bg-primary text-white rounded-pill px-2 py-1" style="font-size: 0.65rem;">
                <i class="bi bi-person-fill me-1"></i> CIUDADANO
              </span>
            )}
            <span class="small font-monospace" style="font-size: 0.75rem;">Rol Actual</span>
            <i class="bi bi-chevron-down small"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-lg p-2" style="background: #0f172a; border: 1px solid #1e3a66; min-width: 220px;" aria-labelledby="roleDropdown">
            <li><h6 class="dropdown-header text-uppercase text-slate-400" style="font-size: 0.65rem;">Modo de Demostración</h6></li>
            <li>
              <a class={`dropdown-item rounded-2 d-flex align-items-center gap-2 py-2 ${activeRole === 'ciudadano' ? 'active bg-primary' : 'text-white'}`} href="?role=ciudadano">
                <i class="bi bi-person-circle fs-5"></i>
                <div>
                  <div class="fw-bold" style="font-size: 0.85rem;">Vista Ciudadano</div>
                  <div class="small opacity-75" style="font-size: 0.7rem;">Crea reportes, ve sus mis reportes</div>
                </div>
              </a>
            </li>
            <li>
              <a class={`dropdown-item rounded-2 d-flex align-items-center gap-2 py-2 mt-1 ${activeRole === 'comite' ? 'active bg-danger' : 'text-white'}`} href="?role=comite">
                <i class="bi bi-shield-lock fs-5"></i>
                <div>
                  <div class="fw-bold" style="font-size: 0.85rem;">Vista Comité (is_staff)</div>
                  <div class="small opacity-75" style="font-size: 0.7rem;">Gestiona estados, filtros y vecinos</div>
                </div>
              </a>
            </li>
          </ul>
        </div>

        <!-- User Logout / Profile -->
        <a href="/login" onclick="localStorage.removeItem('token');" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-color: #334155;" title="Cerrar Sesión / Salir">
          <i class="bi bi-box-arrow-right text-slate-300"></i>
        </a>
      </div>

    </div>
  </div>
</header>