---
import LandingLayout from "../layouts/LandingLayout.astro";

// =========================================================================
// CONFIGURACIÓN DEL TIEMPO ESTIMADO DE DESPLIEGUE (Modificable en este bloque)
// =========================================================================
const ESTIMATED_TIMELINE = "4 a 6 semanas";
const ESTIMATED_DATE = "Noviembre 2026";

// Estado de las etapas del proyecto
const PROJECT_TIMELINE = [
  {
    phase: "Identificación del problema",
    description: "Evaluación de necesidades de comunicación y seguridad en el barrio.",
    status: "completed", // 'completed' | 'in-progress' | 'pending'
    icon: "bi-check-circle-fill",
    badge: "Completado"
  },
  {
    phase: "Diseño de la solución",
    description: "Definición de flujos, mapas interactivos y prototipos para la comunidad.",
    status: "completed",
    icon: "bi-check-circle-fill",
    badge: "Completado"
  },
  {
    phase: "Desarrollo de la plataforma",
    description: "Programación de módulos de reporte, autenticación y panel del comité.",
    status: "in-progress",
    icon: "bi-hammer",
    badge: "En proceso"
  },
  {
    phase: "Pruebas y validación",
    description: "Validación con vecinos del comité y pruebas directas de seguridad digital.",
    status: "pending",
    icon: "bi-shield-check",
    badge: "Próximamente"
  },
  {
    phase: "Primer despliegue oficial",
    description: "Lanzamiento oficial para el uso de las familias de San Luis de Chillogallo.",
    status: "pending",
    icon: "bi-rocket-takeoff",
    badge: "Pendiente"
  }
];

// Los 4 pasos de funcionamiento futuro
const HOW_IT_WORKS_STEPS = [
  {
    stepNumber: "01",
    title: "Reportar",
    icon: "bi-megaphone-fill",
    description: "Cualquier vecino podrá registrar un incidente indicando la ubicación exacta, fotos y categoría en pocos pasos."
  },
  {
    stepNumber: "02",
    title: "Registrar",
    icon: "bi-database-fill-check",
    description: "El reporte se guardará de forma centralizada y segura en el sistema comunitario del barrio."
  },
  {
    stepNumber: "03",
    title: "Revisar",
    icon: "bi-shield-shaded",
    description: "Integrantes del Comité de Seguridad verificarán la novedad para clasificarla y coordinar la acción requerida."
  },
  {
    stepNumber: "04",
    title: "Dar seguimiento",
    icon: "bi-arrow-repeat",
    description: "La comunidad podrá consultar el avance en tiempo real hasta que la novedad sea atendida y resuelta."
  }
];
---

<LandingLayout 
  title="Ciudad Segura | Proyecto Comunitario San Luis de Chillogallo" 
  description="Plataforma comunitaria en desarrollo para organizar, centralizar y dar seguimiento a los reportes de seguridad de San Luis de Chillogallo, Quito."
>
  <!-- TOP BAR / NAVIGATION BRAND -->
  <header class="sticky-top bg-dark border-bottom border-slate-800" style="background-color: #070e1c !important; border-color: rgba(255,255,255,0.08) !important;">
    <div class="container py-2.5 px-3">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-3 p-1.5 d-flex align-items-center justify-content-center text-white" style="background: linear-gradient(135deg, #10b981, #059669); width: 36px; height: 36px;">
            <i class="bi bi-shield-lock-fill fs-5"></i>
          </div>
          <div>
            <div class="fw-bold text-white lh-1 fs-6">Ciudad Segura</div>
            <div class="text-slate-400" style="font-size: 0.7rem; color: #94a3b8;">San Luis de Chillogallo</div>
          </div>
        </div>

        <span class="badge rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.75rem;">
          <span class="badge-pulse"></span>
          <span>En desarrollo</span>
        </span>
      </div>
    </div>
  </header>

  <main class="flex-grow-1">

    <!-- 1. HERO SECTION -->
    <section class="position-relative text-white py-5 py-md-6 overflow-hidden" style="background: linear-gradient(180deg, #070e1c 0%, #0b172a 100%);">
      <!-- Background subtle grid pattern -->
      <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10" style="background-image: radial-gradient(#38bdf8 1px, transparent 1px); background-size: 24px 24px; pointer-events: none;"></div>

      <div class="container position-relative px-3 px-md-4">
        <div class="row align-items-center gy-4">
          <div class="col-12 col-lg-7 text-start">
            
            <!-- Development Tag -->
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill mb-3" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25);">
              <i class="bi bi-info-circle-fill text-emerald-400" style="color: #34d399;"></i>
              <span class="fw-medium text-emerald-300" style="font-size: 0.8rem; color: #6ee7b7;">Plataforma en desarrollo</span>
            </div>

            <!-- Title -->
            <h1 class="display-4 fw-extrabold text-white mb-3" style="letter-spacing: -0.03em; line-height: 1.1;">
              Ciudad Segura
            </h1>

            <!-- Subtitle -->
            <p class="fs-5 text-slate-300 mb-4 max-w-2xl" style="color: #cbd5e1; line-height: 1.5;">
              Una iniciativa para organizar, centralizar y dar seguimiento a los reportes de seguridad de nuestra comunidad.
            </p>

            <!-- Location & Committee Identification Tag -->
            <div class="d-flex align-items-center gap-2 mb-4 text-slate-400 small" style="color: #94a3b8;">
              <i class="bi bi-geo-alt-fill text-danger"></i>
              <span>San Luis de Chillogallo · Quito, Ecuador</span>
            </div>

            <!-- CTA Button -->
            <div class="d-flex flex-wrap align-items-center gap-3">
              <a href="#problema" class="btn btn-lg rounded-pill px-4 py-2.5 fw-semibold text-white cs-transition shadow-lg d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #10b981, #059669); border: none; font-size: 1rem;">
                <span>Conoce el proyecto</span>
                <i class="bi bi-arrow-down-short fs-5"></i>
              </a>

              <a href="#tiempo" class="btn btn-lg btn-outline-light rounded-pill px-4 py-2.5 fw-medium cs-transition d-inline-flex align-items-center gap-2" style="border-color: rgba(255,255,255,0.2); font-size: 0.95rem;">
                <i class="bi bi-calendar-event me-1"></i>
                <span>Ver estimado</span>
              </a>
            </div>

            <!-- Clarification Banner: Application Not Finished Yet -->
            <div class="mt-4.5 p-3 rounded-3 border" style="background: rgba(15, 23, 42, 0.8); border-color: rgba(245, 158, 11, 0.3) !important;">
              <div class="d-flex align-items-start gap-2.5 text-slate-300" style="font-size: 0.825rem; color: #cbd5e1;">
                <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-0.5 fs-6"></i>
                <div>
                  <strong class="text-white d-block mb-0.5">Nota importante para los visitantes:</strong>
                  La aplicación se encuentra en etapa de programación y pruebas. No está disponible aún para iniciar sesión ni registrar incidentes en vivo.
                </div>
              </div>
            </div>

          </div>

          <!-- Hero Illustrative Card / Preview -->
          <div class="col-12 col-lg-5">
            <div class="rounded-4 p-4 p-md-4.5 shadow-2xl position-relative overflow-hidden" style="background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px);">
              <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-slate-700" style="border-color: rgba(255,255,255,0.1) !important;">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-shield-check text-emerald-400 fs-5" style="color: #34d399;"></i>
                  <span class="fw-bold text-white small">Vista preliminar del sistema</span>
                </div>
                <span class="badge bg-slate-800 text-slate-400 font-monospace" style="font-size: 0.65rem; background: #1e293b; color: #94a3b8;">V1.0 (En construcción)</span>
              </div>

              <!-- Mockup Cards showing concept -->
              <div class="d-flex flex-column gap-2.5">
                <div class="p-3 rounded-3 text-start" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.06);">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 0.65rem;">01. ALUMBRADO</span>
                    <span class="text-slate-400 font-monospace" style="font-size: 0.65rem; color: #94a3b8;">Futuro canal de reporte</span>
                  </div>
                  <div class="fw-semibold text-white small">Luminarias dañadas o sectores oscuros</div>
                  <div class="text-slate-400 mt-1" style="font-size: 0.75rem; color: #94a3b8;">Ubicación en mapa + fotografía directa del vecindario</div>
                </div>

                <div class="p-3 rounded-3 text-start" style="background: rgba(30, 41, 59, 0.6); border: 1px solid rgba(255,255,255,0.06);">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="badge bg-info text-dark fw-bold" style="font-size: 0.65rem;">02. NOVEDADES</span>
                    <span class="text-slate-400 font-monospace" style="font-size: 0.65rem; color: #94a3b8;">Organización central</span>
                  </div>
                  <div class="fw-semibold text-white small">Gestión verificada por el Comité</div>
                  <div class="text-slate-400 mt-1" style="font-size: 0.75rem; color: #94a3b8;">Consolidación de alertas evitando desinformación en chats</div>
                </div>

                <div class="p-3 rounded-3 text-start" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2);">
                  <div class="d-flex align-items-center gap-2 text-emerald-300 small" style="color: #6ee7b7; font-size: 0.75rem;">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Solución pensada para las familias de San Luis de Chillogallo</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. EL PROBLEMA SECTION -->
    <section id="problema" class="py-5 py-md-6 bg-white text-dark">
      <div class="container px-3 px-md-4">
        
        <div class="text-center max-w-3xl mx-auto mb-5">
          <span class="badge rounded-pill px-3 py-1.5 mb-2 fw-semibold" style="background: #e0e7ff; color: #3730a3; font-size: 0.8rem;">
            El contexto actual
          </span>
          <h2 class="display-6 fw-bold text-slate-900 mb-3" style="letter-spacing: -0.02em;">
            ¿Por qué surge Ciudad Segura?
          </h2>
          <p class="fs-6 text-slate-600 mb-0" style="color: #475569; line-height: 1.6;">
            En muchas comunidades, la comunicación sobre novedades y seguridad suele gestionarse mediante canales informales. Esto genera problemas frecuentes que buscamos resolver.
          </p>
        </div>

        <div class="row g-4 justify-content-center">
          <!-- Problem Card 1 -->
          <div class="col-12 col-md-4">
            <div class="h-100 p-4 rounded-4 bg-slate-50 border border-slate-200 cs-transition hover-shadow" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
              <div class="rounded-3 p-3 mb-3 d-inline-flex align-items-center justify-content-center text-danger" style="background: #fee2e2; width: 48px; height: 48px;">
                <i class="bi bi-chat-left-dots-fill fs-4"></i>
              </div>
              <h3 class="h5 fw-bold text-slate-900 mb-2">Información dispersa</h3>
              <p class="text-slate-600 small mb-0" style="color: #475569; line-height: 1.6;">
                Los avisos sobre incidentes se pierden entre cientos de mensajes diarios en chats de WhatsApp, comentarios verbales y reuniones informales.
              </p>
            </div>
          </div>

          <!-- Problem Card 2 -->
          <div class="col-12 col-md-4">
            <div class="h-100 p-4 rounded-4 bg-slate-50 border border-slate-200 cs-transition hover-shadow" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
              <div class="rounded-3 p-3 mb-3 d-inline-flex align-items-center justify-content-center text-amber-600" style="background: #fef3c7; color: #d97706; width: 48px; height: 48px;">
                <i class="bi bi-search-heart-fill fs-4"></i>
              </div>
              <h3 class="h5 fw-bold text-slate-900 mb-2">Dificultad de seguimiento</h3>
              <p class="text-slate-600 small mb-0" style="color: #475569; line-height: 1.6;">
                Resulta complejo saber si una luminaria quemada o una novedad ya fue gestionada, quién la atendió o en qué estado se encuentra.
              </p>
            </div>
          </div>

          <!-- Problem Card 3 -->
          <div class="col-12 col-md-4">
            <div class="h-100 p-4 rounded-4 bg-slate-50 border border-slate-200 cs-transition hover-shadow" style="background-color: #f8fafc; border-color: #e2e8f0 !important;">
              <div class="rounded-3 p-3 mb-3 d-inline-flex align-items-center justify-content-center text-emerald-600" style="background: #d1fae5; color: #059669; width: 48px; height: 48px;">
                <i class="bi bi-folder-symlink-fill fs-4"></i>
              </div>
              <h3 class="h5 fw-bold text-slate-900 mb-2">Falta de historial organizado</h3>
              <p class="text-slate-600 small mb-0" style="color: #475569; line-height: 1.6;">
                Al no existir un registro claro, la directiva del comité no cuenta con datos consolidados para priorizar los sectores que requieren mayor atención.
              </p>
            </div>
          </div>
        </div>

        <!-- Problem Banner Summary -->
        <div class="mt-5 p-4 rounded-4 text-white text-center shadow-md" style="background: linear-gradient(135deg, #0b172a, #1e293b);">
          <div class="row align-items-center gy-3">
            <div class="col-12 col-md-8 text-md-start">
              <h4 class="h5 fw-bold mb-1 text-white">Ciudad Segura nace para cambiar esta realidad</h4>
              <p class="text-slate-300 small mb-0" style="color: #cbd5e1;">
                Una herramienta web sencilla para centralizar los reportes del barrio San Luis de Chillogallo y brindar transparencia a toda la comunidad.
              </p>
            </div>
            <div class="col-12 col-md-4 text-md-end">
              <a href="#como-funcionara" class="btn btn-emerald text-white fw-semibold rounded-pill px-4 py-2" style="background: #10b981; border: none;">
                ¿Cómo funcionará? <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. ¿CÓMO FUNCIONARÁ? SECTION -->
    <section id="como-funcionara" class="py-5 py-md-6" style="background-color: #f1f5f9;">
      <div class="container px-3 px-md-4">
        
        <div class="text-center max-w-3xl mx-auto mb-5">
          <span class="badge rounded-pill px-3 py-1.5 mb-2 fw-semibold" style="background: #dcfce7; color: #166534; font-size: 0.8rem;">
            Diseño del proceso
          </span>
          <h2 class="display-6 fw-bold text-slate-900 mb-3" style="letter-spacing: -0.02em;">
            ¿Cómo funcionará la plataforma?
          </h2>
          <p class="fs-6 text-slate-600 mb-2" style="color: #475569; line-height: 1.6;">
            Una vez desplegada, la plataforma permitirá gestionar las novedades del sector en 4 pasos sencillos y ordenados:
          </p>
          <div class="d-inline-flex align-items-center gap-1.5 px-3 py-1 rounded-pill bg-white border border-slate-300 text-slate-600" style="font-size: 0.75rem;">
            <i class="bi bi-lock-fill text-muted"></i>
            <span>* Funciones en etapa de programación (Próximamente disponibles)</span>
          </div>
        </div>

        <div class="row g-4">
          {HOW_IT_WORKS_STEPS.map((step) => (
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="h-100 p-4 rounded-4 bg-white border border-slate-200 shadow-sm position-relative d-flex flex-column cs-transition hover-translate-y">
                
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <span class="font-monospace fw-extrabold text-slate-300 fs-3" style="color: #cbd5e1; line-height: 1;">
                    {step.stepNumber}
                  </span>
                  <span class="badge bg-slate-100 text-slate-600 border border-slate-200 rounded-pill px-2.5 py-1" style="font-size: 0.7rem; background: #f8fafc; color: #64748b;">
                    Próximamente
                  </span>
                </div>

                <div class="rounded-3 p-2.5 mb-3 text-emerald-600 d-inline-flex align-items-center justify-content-center" style="background: #ecfdf5; color: #059669; width: 44px; height: 44px;">
                  <i class={`bi ${step.icon} fs-4`}></i>
                </div>

                <h3 class="h5 fw-bold text-slate-900 mb-2">{step.title}</h3>
                <p class="text-slate-600 small mb-0 flex-grow-1" style="color: #475569; line-height: 1.6;">
                  {step.description}
                </p>

              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. ESTADO DEL PROYECTO SECTION -->
    <section id="estado" class="py-5 py-md-6 bg-white">
      <div class="container px-3 px-md-4">
        
        <div class="text-center max-w-3xl mx-auto mb-5">
          <span class="badge rounded-pill px-3 py-1.5 mb-2 fw-semibold" style="background: #fef3c7; color: #92400e; font-size: 0.8rem;">
            Línea de progreso
          </span>
          <h2 class="display-6 fw-bold text-slate-900 mb-3" style="letter-spacing: -0.02em;">
            Estado actual del proyecto
          </h2>
          <p class="fs-6 text-slate-600 mb-0" style="color: #475569; line-height: 1.6;">
            Avanzamos con transparencia en cada fase para asegurar que la herramienta sea segura, rápida y fácil de usar para todos los vecinos.
          </p>
        </div>

        <!-- Timeline Container -->
        <div class="max-w-3xl mx-auto">
          <div class="position-relative">
            
            {PROJECT_TIMELINE.map((item, index) => (
              <div class="d-flex align-items-start gap-3.5 mb-4 position-relative">
                
                <!-- Status Icon Circle -->
                <div class={`rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-white shadow-sm ${
                  item.status === 'completed' ? 'bg-emerald-500' :
                  item.status === 'in-progress' ? 'bg-amber-500' : 'bg-slate-300'
                }`} style={{
                  width: '42px',
                  height: '42px',
                  backgroundColor: item.status === 'completed' ? '#10b981' : item.status === 'in-progress' ? '#f59e0b' : '#cbd5e1',
                  color: item.status === 'pending' ? '#64748b' : '#ffffff',
                  zIndex: 2
                }}>
                  {item.status === 'completed' && <i class="bi bi-check-lg fs-5"></i>}
                  {item.status === 'in-progress' && <i class="bi bi-hammer fs-6"></i>}
                  {item.status === 'pending' && <span class="fw-bold font-monospace small">{index + 1}</span>}
                </div>

                <!-- Content Card -->
                <div class="flex-grow-1 p-3.5 p-md-4 rounded-4 border bg-white shadow-xs" style={{
                  borderColor: item.status === 'in-progress' ? '#fde68a' : '#e2e8f0',
                  backgroundColor: item.status === 'in-progress' ? '#fffbeb' : '#ffffff'
                }}>
                  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                    <h3 class="h6 fw-bold text-slate-900 mb-0">
                      {item.phase}
                    </h3>

                    <!-- Status Badge -->
                    <span class={`badge rounded-pill px-3 py-1 font-medium ${
                      item.status === 'completed' ? 'bg-emerald-100 text-emerald-800' :
                      item.status === 'in-progress' ? 'bg-amber-200 text-amber-900' : 'bg-slate-100 text-slate-600'
                    }`} style={{
                      backgroundColor: item.status === 'completed' ? '#d1fae5' : item.status === 'in-progress' ? '#fef3c7' : '#f1f5f9',
                      color: item.status === 'completed' ? '#065f46' : item.status === 'in-progress' ? '#92400e' : '#64748b',
                      fontSize: '0.75rem'
                    }}>
                      {item.badge}
                    </span>
                  </div>

                  <p class="text-slate-600 small mb-0" style="color: #475569; line-height: 1.5;">
                    {item.description}
                  </p>
                </div>

              </div>
            ))}

          </div>
        </div>

      </div>
    </section>

    <!-- 5. TIEMPO DE DESPLIEGUE SECTION -->
    <section id="tiempo" class="py-5 py-md-6 text-white" style="background: linear-gradient(135deg, #070e1c 0%, #0f172a 100%);">
      <div class="container px-3 px-md-4 text-center max-w-3xl">
        
        <div class="rounded-4 p-4.5 p-md-5 border shadow-2xl position-relative overflow-hidden" style="background: rgba(15, 23, 42, 0.95); border-color: rgba(16, 185, 129, 0.3) !important;">
          
          <!-- Decorative Glow -->
          <div class="position-absolute top-0 start-50 translate-middle-x rounded-circle opacity-20" style="width: 250px; height: 250px; background: #10b981; filter: blur(80px); pointer-events: none;"></div>

          <div class="position-relative">
            <span class="badge rounded-pill px-3.5 py-1.5 mb-3 fw-semibold text-emerald-300" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.8rem;">
              <i class="bi bi-clock-history me-1"></i> Cronograma estimado
            </span>

            <h2 class="display-6 fw-bold text-white mb-3" style="letter-spacing: -0.02em;">
              Primer despliegue estimado
            </h2>

            <!-- Highlighted Timeline Container -->
            <div class="my-4 py-4 px-3 rounded-3 bg-slate-900 border border-slate-700 d-inline-block w-100 max-w-md" style="background-color: #070e1c !important; border-color: rgba(255,255,255,0.12) !important;">
              <div class="text-slate-400 small text-uppercase font-monospace mb-1" style="color: #94a3b8; font-size: 0.75rem; letter-spacing: 0.05em;">
                Tiempo estimado de desarrollo
              </div>
              <div class="display-5 fw-extrabold text-emerald-400 mb-1" style="color: #34d399; letter-spacing: -0.03em;">
                {ESTIMATED_TIMELINE}
              </div>
              <div class="fs-6 text-slate-300 fw-medium" style="color: #cbd5e1;">
                Aproximadamente <span class="text-white border-bottom border-emerald-500 pb-0.5">{ESTIMATED_DATE}</span>
              </div>
            </div>

            <!-- Disclaimer note -->
            <p class="text-slate-300 small max-w-xl mx-auto mb-0" style="color: #cbd5e1; line-height: 1.6; font-size: 0.875rem;">
