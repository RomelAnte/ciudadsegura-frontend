---
// Frontmatter: corre en el servidor. Por ahora no necesitamos nada aquí,
// pero aquí es donde más adelante harías un fetch para precargar datos
// (ej. para el mapa, cuando pidamos los reportes existentes).
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>CiudadSegura</title>
	</head>
	<body>
		<h1>Reportar incidente</h1>

		<form id="report-form">
			<label>
				Descripción
				<textarea name="description" required></textarea>
			</label>

			<label>
				Dirección
				<input type="text" name="address" required />
			</label>

			<!-- Por ahora manuales. Cuando integremos Leaflet, estos dos
			     se van a llenar solos al hacer click en el mapa. -->
			<label>
				Latitud
				<input type="number" step="any" name="latitude" required />
			</label>
			<label>
				Longitud
				<input type="number" step="any" name="longitude" required />
			</label>

			<label>
				Foto (opcional)
				<input type="file" name="picture" accept="image/*" />
			</label>

			<button type="submit">Enviar reporte</button>
		</form>

		<p id="status"></p>

		<script>
			// Esto SÍ corre en el navegador. Es tu fetch/AJAX de siempre.
			const API_URL = import.meta.env.PUBLIC_API_URL;

			const form = document.getElementById('report-form') as HTMLFormElement;
			const status = document.getElementById('status') as HTMLParagraphElement;

			form.addEventListener('submit', async (event) => {
				event.preventDefault();

				// FormData lee directamente los inputs del form por su atributo "name".
				// Esto es clave: como tu picture es ImageField y probaste con éxito
				// multipart/form-data en Postman, FormData hace exactamente eso mismo.
				const formData = new FormData(form);

				status.textContent = 'Enviando...';

				try {
					const response = await fetch(`${API_URL}/api/reportes/`, {
						method: 'POST',
						body: formData,
						// IMPORTANTE: no pongas headers de Content-Type manualmente.
						// El navegador genera el boundary correcto del multipart solo.
						// Si lo fuerzas a mano, DRF no puede parsear el body.
					});

					if (!response.ok) {
						const errorData = await response.json();
						throw new Error(JSON.stringify(errorData));
					}

					const data = await response.json();
					status.textContent = `Reporte creado con id ${data.id}`;
					form.reset();
				} catch (err) {
					console.error(err);
					status.textContent = 'Error al enviar el reporte. Revisa la consola.';
				}
			});
		</script>
	</body>
</html>